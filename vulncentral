
CREATE TABLE vulnerabilities (
    id SERIAL PRIMARY KEY,
    cve_id VARCHAR(32) UNIQUE NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    severity VARCHAR(10) NOT NULL,
    cvss_score NUMERIC(3,1),
    affected_product TEXT,
    remediation TEXT
);

